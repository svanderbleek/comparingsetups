{:paths ["src/backend" "resources"]

 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        ring/ring-core {:mvn/version "1.13.0"}
        ring/ring-jetty-adapter {:mvn/version "1.13.0"}
        metosin/reitit {:mvn/version "0.7.2"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.994"}
        org.postgresql/postgresql {:mvn/version "42.7.4"}
        metosin/jsonista {:mvn/version "0.3.13"}
        ring-cors/ring-cors {:mvn/version "0.1.13"}}

 :aliases
 {:frontend
  {:extra-paths ["src/frontend"]
   :extra-deps {reagent/reagent {:mvn/version "1.2.0"}
                re-frame/re-frame {:mvn/version "1.4.3"}
                day8.re-frame/http-fx {:mvn/version "0.2.4"}
                cljs-ajax/cljs-ajax {:mvn/version "0.8.4"}
                thheller/shadow-cljs {:mvn/version "2.28.23"}}}

  :run
  {:main-opts ["-m" "myapp.server.core"]}

  :build
  {:deps {io.github.clojure/tools.build {:mvn/version "0.10.5"}}
   :ns-default build}}}
