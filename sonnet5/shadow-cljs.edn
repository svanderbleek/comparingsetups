{:deps {:aliases [:frontend]}

 :dev-http {8280 {:root "resources/public"
                   :proxy-url "http://localhost:3000"}}

 :builds
 {:app
  {:target :browser
   :output-dir "resources/public/js"
   :asset-path "/js"
   :modules {:main {:init-fn myapp.client.core/init}}
   :devtools {:after-load myapp.client.core/mount-root}}}}
