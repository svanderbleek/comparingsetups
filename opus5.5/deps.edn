{:paths ["src/clj" "resources"]

 :deps {org.clojure/clojure               {:mvn/version "1.12.3"}
        ring/ring-jetty-adapter           {:mvn/version "1.15.5"}
        metosin/reitit-ring               {:mvn/version "0.11.0"}
        metosin/reitit-middleware         {:mvn/version "0.11.0"}
        metosin/muuntaja                  {:mvn/version "0.6.12"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.1118"}
        org.postgresql/postgresql         {:mvn/version "42.7.13"}
        com.zaxxer/HikariCP               {:mvn/version "7.1.0"}}

 :aliases
 {;; clj -M:run  — start the server
  :run   {:main-opts ["-m" "app.main"]}

  ;; clj -M:dev  — REPL with dev helpers on the classpath
  :dev   {:extra-paths ["dev"]}

  ;; used by shadow-cljs (see shadow-cljs.edn :deps)
  :cljs  {:extra-paths ["src/cljs"]
          :extra-deps  {thheller/shadow-cljs {:mvn/version "3.5.3"}
                        re-frame/re-frame    {:mvn/version "1.4.7"}
                        reagent/reagent      {:mvn/version "2.0.1"}
                        day8.re-frame/http-fx {:mvn/version "0.2.4"}}}

  ;; clj -T:build uber
  :build {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
          :ns-default build}}}
